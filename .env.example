# Neon POOLED connection string (Project → Connection Details → "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Shared secret the GitHub Actions poller will send (used from Phase 2 onward)
POLL_SECRET="change-me-to-a-long-random-string"

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional OAuth providers. Configure either Google, GitHub, or both.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated emails that can run the manual global poll from the UI.
ADMIN_EMAILS="you@example.com"

# Google Gemini API key for AI tagging (Phase 6) + summaries (Phase 9).
# Get a free key at https://aistudio.google.com/apikey . Optional: if unset,
# tagging falls back to keyword-only (AI step is skipped gracefully).
# Set this in .env.local and in Vercel env vars (NOT needed in GitHub secrets).
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"
